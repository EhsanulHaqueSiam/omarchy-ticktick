#!/usr/bin/env python3
"""Launcher for the `ticktick` CLI.

The plugin is a plain `git clone` into `~/.config/omarchy/plugins/siam.ticktick/` with
no install step, so nothing ever puts the package on `sys.path` for us. `resolve()`
follows symlinks first, which is what makes `ln -s .../bin/ticktick ~/.local/bin/ticktick`
work instead of importing whatever `ticktick` happens to sit next to the symlink.

The interpreter check happens here, before any package import, and answers in the JSON
the widget expects. On an older Python the failure would otherwise be a `SyntaxError`
traceback on stderr and nothing at all on stdout, which the widget renders as a blank
slot with no explanation — the single hardest failure to diagnose from a bar.
"""

import json
import pathlib
import sys

MINIMUM = (3, 11)

if sys.version_info < MINIMUM:
    json.dump(
        {
            "ok": False,
            "error": "usage",
            "message": (
                f"needs Python {MINIMUM[0]}.{MINIMUM[1]}+ but this is "
                f"{sys.version_info.major}.{sys.version_info.minor} "
                f"({sys.executable}). Omarchy ships a new enough one; something "
                f"earlier on PATH is shadowing it."
            ),
        },
        sys.stdout,
    )
    sys.stdout.write("\n")
    raise SystemExit(0)  # the contract is exit 0 with a payload, even for this

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))

from ticktick.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
